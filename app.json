{
  "expo": {
    "name": "NASRDA Attendance",
    "slug": "nasrda-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nasrdaattendance",
    "userInterfaceStyle": "light",
    "backgroundColor": "#19297D",
    "ios": {
      "bundleIdentifier": "ng.gov.nasrda.attendance",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NASRDA Attendance uses your location to confirm you are within an authorised campus when you check in or out.",
        "NSCameraUsageDescription": "NASRDA Attendance uses the front camera to verify your face when you check in or out."
      }
    },
    "android": {
      "package": "ng.gov.nasrda.attendance",
      "adaptiveIcon": {
        "backgroundColor": "#19297D",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#19297D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NASRDA Attendance uses your location to confirm you are within an authorised campus when you check in or out."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NASRDA Attendance uses the front camera to verify your face when you check in or out.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0866dd97-68ee-4a54-a851-037049e1b0bb"
      }
    }
  }
}
